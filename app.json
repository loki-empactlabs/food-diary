{
  "expo": {
    "name": "Food Diary",
    "slug": "food-diary",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fooddiary",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFDF1"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fooddiary.app",
      "infoPlist": {
        "NSCameraUsageDescription": "음식 사진을 촬영하기 위해 카메라 접근이 필요합니다.",
        "NSPhotoLibraryUsageDescription": "갤러리에서 음식 사진을 선택하기 위해 접근이 필요합니다.",
        "NSLocationWhenInUseUsageDescription": "음식을 기록한 위치를 저장하기 위해 위치 접근이 필요합니다."
      }
    },
    "android": {
      "package": "com.fooddiary.app",
      "adaptiveIcon": {
        "backgroundColor": "#FF9644",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-sharing",
      "expo-camera",
      "expo-image-picker",
      "expo-location",
      ["@sentry/react-native", { "uploadSourceMaps": false }]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/food-diary"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aa663f54-9566-4010-abb4-ce4469259fa0"
      }
    },
    "owner": "acoz"
  }
}
